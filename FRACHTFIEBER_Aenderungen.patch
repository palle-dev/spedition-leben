+  if (vehicle.type === "Schwerer Fernverkehrs-Lkw") return VEHICLE_CATALOG.heavy;
+  // Standard-Lkw und alle älteren Fahrzeuge (inkl. Miet-Lkw, Leasing, Tank) → Standard
+  return VEHICLE_CATALOG.standard;
