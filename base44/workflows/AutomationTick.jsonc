{
  "description": "Verarbeitet alle Spielst\u00e4nde mit aktivierter Zeitautomatik alle 5 Minuten. L\u00e4uft auch bei geschlossener App weiter.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "automation_tick",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "tick": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processAutomationTick",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Automatik-Tick verarbeiten",
            "description": "F\u00e4llige Spielzeit f\u00fcr alle aktiven Spielst\u00e4nde verarbeiten"
          }
        }
      }
    ]
  },
  "name": "Automatik-Tick",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "Europe/Berlin",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}