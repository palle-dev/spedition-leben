{
  "name": "GameState",
  "type": "object",
  "properties": {
    "revision": {
      "type": "number"
    },
    "state": {
      "type": [
        "object",
        "string"
      ],
      "description": "Full game state object, or 'uri:<file_uri>' string when offloaded to private file storage for large saves."
    },
    "owner_id": {
      "type": "string"
    },
    "last_action_id": {
      "type": "string"
    },
    "last_result": {
      "type": "object"
    },
    "last_command_hash": {
      "type": "string"
    },
    "automation_enabled": {
      "type": "boolean",
      "default": false
    },
    "party_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "game_day": {
      "type": "number"
    },
    "game_time_min": {
      "type": "number"
    },
    "scenario_id": {
      "type": "string"
    },
    "difficulty_profile": {
      "type": "string"
    },
    "save_label": {
      "type": "string"
    },
    "save_type": {
      "type": "string"
    },
    "cloud_saved_at": {
      "type": "number"
    },
    "archive_blocks": {
      "type": "object",
      "description": "Server-owned content-hash to immutable archive entity ID map."
    }
  },
  "rls": {
    "read": {
      "data.owner_id": "{{user.id}}"
    },
    "create": false,
    "update": false,
    "delete": false
  },
  "required": []
}